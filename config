Host *
    User default_user
    Port 2222
    ServerAliveInterval 60
    

Host prod-*
    User prod_admin
    Port 22
    Compression yes

Host myserver
    HostName 192.168.1.100
    User myusername
    IdentityFile ~/.ssh/id_rsa
    Port 22

Host backup-server
    HostName backup.internal

Host prod-db
    HostName db.prod.example.com
    IdentityFile ~/.ssh/prod_key.pem

Host broken-server
    User test_user

Host ghost-server

Host messy-server
    HostName    10.10.10.10
    User      messy_user
    Port        8080
